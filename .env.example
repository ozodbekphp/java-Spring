APP_NAME=learning-backend
SERVER_PORT=8088

# PostgreSQL Database sozlamalari
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ishonch_db
DB_USER=postgres
DB_PASSWORD=

# JPA / Hibernate sozlamalari
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Flyway migratsiya sozlamalari
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_VALIDATE_ON_MIGRATE=false
